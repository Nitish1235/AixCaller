# =========================================================================
# CLOUD RUN ENVIRONMENT VARIABLES GUIDE
# =========================================================================
# When deploying to Google Cloud Run, do not deploy a single .env file.
# Instead, add these variables specifically to the respective services.
# =========================================================================


# =========================================================================
# 1. BACKEND SERVICE (Cloud Run)
# =========================================================================
# Core Security
JWT_SECRET="your_very_long_random_string_here"
INTERNAL_API_KEY="your_internal_service_key_here"

# Database & Cache (Connection Strings)
DATABASE_URL="postgresql://user:pass@host:6543/dbname" # MUST use Transaction Pooler URL
DATABASE_DIRECT_URL="postgresql://user:pass@host:5432/dbname" # Needed ONLY for the init_db migration job
REDIS_URL="redis://host:6379/0" # Optional, for caching

# Service URLs & CORS
ALLOWED_ORIGINS="https://callerx.ai,https://www.callerx.ai"
SERVER_HOST="api.callerx.ai"  # The Cloud Run URL for your backend (without https://)

# Telecom & AI Providers
TELNYX_API_KEY="KEY..."
TELNYX_CONNECTION_ID="your_telnyx_connection_id"
DEEPGRAM_API_KEY="KEY..."
OPENAI_API_KEY="sk-..."

# Payments (Dodo Payments)
DODO_PAYMENTS_API_KEY="dp_live_..."
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
DODO_PRODUCT_STARTER="prod_..."
DODO_PRODUCT_PRO="prod_..."
DODO_PRODUCT_PREMIUM="prod_..."

# Integrations / OAuth Clients
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="https://api.callerx.ai/api/v1/google/callback"

ZOHO_CLIENT_ID="1000.xxxx"
ZOHO_CLIENT_SECRET="xxxx"
ZOHO_REDIRECT_URI="https://api.callerx.ai/api/v1/zoho/callback"

# Admin Alerts & Emails
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
ADMIN_TELEGRAM_CHAT_ID="your_telegram_id"
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="AIxCaller <noreply@aixcaller.com>"



# =========================================================================
# 2. OUTBOUND SERVICE (Cloud Run)
# =========================================================================
# Note: The Outbound service handles dialing, AI lead scoring, and appointment reminders.
# It runs cron tasks via Cloud Scheduler.

# Database
DATABASE_URL="postgresql://user:pass@host:6543/dbname" # MUST match Backend (Transaction Pooler)

# Telecom
TELNYX_API_KEY="KEY..."
TELNYX_CONNECTION_ID="your_telnyx_connection_id"

# AI Providers
OPENAI_API_KEY="sk-..."

# Service URLs
SERVER_HOST="api.callerx.ai"  # MUST match Backend


# =========================================================================
# 3. FRONTEND SERVICE (Vercel or Cloud Run)
# =========================================================================
# Note: If deploying frontend to Cloud Run instead of Vercel, use these.

# Public API URL (Where the frontend sends requests)
NEXT_PUBLIC_API_URL="https://api.callerx.ai"

# Google OAuth (For the "Sign in with Google" button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
